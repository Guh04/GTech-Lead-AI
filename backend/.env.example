# =============================================================================
# GTech Lead AI - variáveis de ambiente do backend
# Copie este arquivo para ".env" (na pasta backend) e preencha os valores.
# NUNCA versione o arquivo .env.
# =============================================================================

# --- Supabase (Project Settings > API) ---------------------------------------
# URL do projeto, ex.: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Chave pública "anon". É a ÚNICA chave usada pela aplicação: o acesso aos dados
# é protegido por RLS usando o token do próprio usuário logado.
# Não use a chave "service_role" aqui.
SUPABASE_ANON_KEY=

# --- Aplicação ---------------------------------------------------------------
# development | production  (em production, a documentação /docs é desativada)
APP_ENV=development
# Fuso usado para agrupar leads por dia nos gráficos
APP_TIMEZONE=America/Sao_Paulo
# Só é necessário se o frontend for hospedado em OUTRO domínio (separado por vírgula).
# Servindo tudo pelo FastAPI (padrão), deixe vazio.
CORS_ORIGINS=

# --- Prospecção gratuita com OpenStreetMap (sem chave, sem cartão) -----------------
# Ativa por padrão quando nenhum outro provedor está configurado. Cobertura menor que a do Google.
# Use OSM_ENABLED=false para desligar a busca automática.
OSM_ENABLED=true

# --- Prospecção real com Google Places (opcional) --------------------------------
# Chave da Google Cloud com a "Places API (New)" ativada e faturamento habilitado.
# Restrinja a chave à Places API (New). Vazio = busca automática desligada.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TIMEOUT_SECONDS=20

# --- Agente de prospecção próprio (opcional) -------------------------------------
# URL base de uma API de prospecção que siga o contrato descrito em docs/README.md.
# Vazio = nenhum agente conectado (a tela de Prospecção avisará o usuário).
PROSPECTING_API_URL=
PROSPECTING_API_KEY=
PROSPECTING_TIMEOUT_SECONDS=120
